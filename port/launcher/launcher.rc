// The program icon and version information of the game's executable. GAME_NAME and GAME_VER come from the build.
#include <winver.h>
103 ICON "icon.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION GAME_VER_NUM
 PRODUCTVERSION GAME_VER_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", GAME_NAME
            VALUE "ProductName", GAME_NAME
            VALUE "FileVersion", GAME_VER
            VALUE "ProductVersion", GAME_VER
            VALUE "OriginalFilename", GAME_NAME ".exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
